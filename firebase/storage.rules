rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.ativo == true
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.tipo == 'admin';
    }

    function ownsProposal(propostaId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/propostas/$(propostaId))
        && firestore.get(/databases/(default)/documents/propostas/$(propostaId)).data.corretorId == request.auth.uid;
    }

    function validDocumentFile() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    function validContractFile() {
      return request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /propostas/{propostaId}/documentos/{documentoId}/{fileName} {
      allow read: if isAdmin() || ownsProposal(propostaId);
      allow create, update: if validDocumentFile()
        && (isAdmin() || ownsProposal(propostaId));
      allow delete: if false;
    }

    match /propostas/{propostaId}/contratos/{contratoId}/{fileName} {
      allow read: if isAdmin() || ownsProposal(propostaId);
      allow create, update: if isAdmin() && validContractFile();
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
