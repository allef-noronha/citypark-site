rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.tipo == 'admin';
    }

    function isApprovedBroker() {
      return signedIn()
        && exists(/databases/$(database)/documents/corretores/$(request.auth.uid))
        && get(/databases/$(database)/documents/corretores/$(request.auth.uid)).data.aprovado == true;
    }

    function ownsProposal(propostaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/propostas/$(propostaId))
        && get(/databases/$(database)/documents/propostas/$(propostaId)).data.corretorId == request.auth.uid;
    }

    function canAccessProposal(propostaId) {
      return isAdmin() || ownsProposal(propostaId);
    }

    function validPaymentComponent(component, periodicity, requireDates, maxQuantity) {
      return component is map
        && component.keys().hasAll([
          'ativo', 'quantidade', 'valorUnitarioCentavos', 'totalCentavos',
          'periodicidade', 'primeiroVencimento', 'vencimentos', 'descricao'
        ])
        && component.keys().hasOnly([
          'ativo', 'quantidade', 'valorUnitarioCentavos', 'totalCentavos',
          'periodicidade', 'primeiroVencimento', 'vencimentos', 'descricao'
        ])
        && component.ativo is bool
        && component.quantidade is int
        && component.valorUnitarioCentavos is int
        && component.totalCentavos is int
        && component.periodicidade == periodicity
        && component.vencimentos is list
        && component.descricao is string
        && component.descricao.size() <= 300
        && (
          (
            component.ativo == true
            && component.quantidade > 0
            && component.quantidade <= maxQuantity
            && component.valorUnitarioCentavos > 0
            && component.totalCentavos == component.quantidade * component.valorUnitarioCentavos
            && (
              (
                requireDates == true
                && component.primeiroVencimento is timestamp
                && component.vencimentos.size() == component.quantidade
              )
              ||
              (
                requireDates == false
                && (component.primeiroVencimento == null || component.primeiroVencimento is timestamp)
              )
            )
          )
          ||
          (
            component.ativo == false
            && component.quantidade == 0
            && component.valorUnitarioCentavos == 0
            && component.totalCentavos == 0
            && component.primeiroVencimento == null
            && component.vencimentos.size() == 0
            && component.descricao == ''
          )
        );
    }

    function validPaymentCondition(data, unidadeId) {
      let condition = data.condicaoProposta;
      let parts = condition.componentes;
      let values = getAfter(/databases/$(database)/documents/unidades/$(unidadeId)).data.valores;
      let tableValue = values.get(
        'precoAVistaCentavos',
        values.get('precoAVista', values.get('precoVistaCentavos', values.get('precoVista', null)))
      );
      let requireDates = condition.tipo == 'personalizada';
      return condition is map
        && condition.keys().hasAll([
          'schemaVersao', 'tipo', 'descricao', 'valorTabelaCentavos',
          'totalCalculadoCentavos', 'diferencaCentavos', 'componentes'
        ])
        && condition.keys().hasOnly([
          'schemaVersao', 'tipo', 'descricao', 'valorTabelaCentavos',
          'totalCalculadoCentavos', 'diferencaCentavos', 'componentes'
        ])
        && condition.schemaVersao == 2
        && condition.tipo in ['padrao', 'personalizada']
        && condition.descricao is string
        && condition.descricao.size() > 0
        && condition.valorTabelaCentavos is int
        && condition.totalCalculadoCentavos is int
        && condition.diferencaCentavos is int
        && tableValue is int
        && condition.valorTabelaCentavos == tableValue
        && condition.totalCalculadoCentavos == tableValue
        && condition.diferencaCentavos == 0
        && parts is map
        && parts.keys().hasAll(['sinal', 'mensais', 'semestrais', 'anuais', 'negociacaoEspecial', 'chaves'])
        && parts.keys().hasOnly(['sinal', 'mensais', 'semestrais', 'anuais', 'negociacaoEspecial', 'chaves'])
        && validPaymentComponent(parts.sinal, 'unica', requireDates, 1)
        && validPaymentComponent(parts.mensais, 'mensal', requireDates, 240)
        && validPaymentComponent(parts.semestrais, 'semestral', requireDates, 60)
        && validPaymentComponent(parts.anuais, 'anual', requireDates, 30)
        && validPaymentComponent(parts.negociacaoEspecial, 'outra', requireDates, 1)
        && validPaymentComponent(parts.chaves, 'unica', requireDates, 1)
        && parts.sinal.ativo == true
        && parts.chaves.ativo == true
        && (
          parts.negociacaoEspecial.ativo == false
          || parts.negociacaoEspecial.descricao.size() > 0
        )
        && condition.totalCalculadoCentavos ==
          parts.sinal.totalCentavos
          + parts.mensais.totalCentavos
          + parts.semestrais.totalCentavos
          + parts.anuais.totalCentavos
          + parts.negociacaoEspecial.totalCentavos
          + parts.chaves.totalCentavos;
    }

    match /corretores/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == false
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'cpf', 'creci', 'telefone', 'imobiliaria'])
      );

      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /unidades/{unidadeId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        isApprovedBroker()
        && resource.data.status == 'disponivel'
        && request.resource.data.status == 'reservada'
        && request.resource.data.propostaAtualId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'propostaAtualId', 'atualizadoEm', 'expiraEm', 'vendidoEm'])
        && getAfter(/databases/$(database)/documents/propostas/$(request.resource.data.propostaAtualId)).data.corretorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/propostas/$(request.resource.data.propostaAtualId)).data.unidadeId == unidadeId
      );
    }

    match /propostas/{propostaId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );

      allow create: if (
          (
            isApprovedBroker()
            && request.resource.data.corretorId == request.auth.uid
          )
          ||
          (
            isAdmin()
            && request.resource.data.corretorId is string
            && exists(/databases/$(database)/documents/corretores/$(request.resource.data.corretorId))
            && get(/databases/$(database)/documents/corretores/$(request.resource.data.corretorId)).data.aprovado == true
            && request.resource.data.adminId == request.auth.uid
          )
        )
        && request.resource.data.statusProposta == 'reservada'
        && request.resource.data.declaracaoAceita == true
        && request.resource.data.unidadeId is string
        && validPaymentCondition(request.resource.data, request.resource.data.unidadeId)
        && getAfter(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.status == 'reservada'
        && getAfter(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.propostaAtualId == propostaId;

      allow update, delete: if isAdmin();

      match /documentos/{documentoId} {
        allow read: if canAccessProposal(propostaId);
        allow create: if isAdmin() || (
          isApprovedBroker()
          && ownsProposal(propostaId)
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.status == 'enviado'
        );
        allow update: if isAdmin() || (
          isApprovedBroker()
          && ownsProposal(propostaId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['arquivo', 'status', 'enviadoEm', 'atualizadoEm'])
          && request.resource.data.status == 'enviado'
        );
        allow delete: if false;
      }

      match /contratos/{contratoId} {
        allow read: if canAccessProposal(propostaId);
        allow create, update: if isAdmin();
        allow delete: if false;
      }

      match /mensagens/{mensagemId} {
        allow read: if canAccessProposal(propostaId);
        allow create: if canAccessProposal(propostaId)
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && (
            (isAdmin() && request.resource.data.autorTipo == 'admin')
            || (ownsProposal(propostaId) && request.resource.data.autorTipo == 'corretor')
          );
        allow update, delete: if false;
      }
    }

    match /historico_propostas/{historicoId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );
      allow create: if isAdmin() || (
        isApprovedBroker()
        && request.resource.data.corretorId == request.auth.uid
        && request.resource.data.acao == 'proposta criada'
      );
      allow update, delete: if false;
    }

    match /historico_unidades/{historicoId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );
      allow create: if isAdmin() || (
        isApprovedBroker()
        && request.resource.data.corretorId == request.auth.uid
        && request.resource.data.acao == 'unidade reservada'
      );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
