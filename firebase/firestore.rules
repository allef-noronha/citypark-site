rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // BETA 9 · LEITURA COMERCIAL TESTE
    // Coleções temporárias usadas somente durante a integração.
    // Escrita pelo cliente continua proibida.
    match /site_units_test/{unitId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /site_conditions_test/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.tipo == 'admin';
    }

    function isApprovedBroker() {
      return signedIn()
        && exists(/databases/$(database)/documents/corretores/$(request.auth.uid))
        && get(/databases/$(database)/documents/corretores/$(request.auth.uid)).data.aprovado == true;
    }

    function ownsProposal(propostaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/propostas/$(propostaId))
        && get(/databases/$(database)/documents/propostas/$(propostaId)).data.corretorId == request.auth.uid;
    }

    function canAccessProposal(propostaId) {
      return isAdmin() || ownsProposal(propostaId);
    }

    // Valida cada componente uma vez. Campos inativos têm uma forma canônica;
    // não percorrem as validações de valor, calendário e periodicidade ativos.
    function validInactivePaymentComponent(component, empty) {
      return component == empty
        && component.quantidade is int
        && component.valorUnitarioCentavos is int
        && component.totalCentavos is int;
    }

    function validActivePaymentComponent(component, requireDates, maxQuantity) {
      let quantity = component.quantidade;
      let unitValue = component.valorUnitarioCentavos;
      let total = component.totalCentavos;
      let description = component.descricao;
      let firstDue = component.primeiroVencimento;
      let dates = component.vencimentos;
      // Todos os campos permitidos são acessados nesta validação ou no chamador.
      // Campo ausente causa negativa; size impede campos extras.
      return component.size() == 8
        && quantity is int && quantity > 0 && quantity <= maxQuantity
        && unitValue is int && unitValue > 0
        && total is int && total == quantity * unitValue
        && description is string && description.size() <= 300
        && dates is list
        && (requireDates
          ? firstDue is timestamp && dates.size() == quantity
          : firstDue == null || firstDue is timestamp);
    }

    function validOptionalFixedPaymentComponent(component, periodicity, requireDates, maxQuantity, empty) {
      return component.ativo
        ? component.periodicidade == periodicity
          && validActivePaymentComponent(component, requireDates, maxQuantity)
        : validInactivePaymentComponent(component, empty);
    }

    function validSignalPaymentComponent(component, requireDates, empty) {
      return component.ativo
        ? (component.periodicidade == 'mensal'
            || (component.periodicidade == 'unica' && component.quantidade == 1))
          && validActivePaymentComponent(component, requireDates, 3)
        : validInactivePaymentComponent(component, empty);
    }

    function validFlexiblePaymentComponent(component, requireDates, empty, limits) {
      let periodicity = component.periodicidade;
      return component.ativo
        ? periodicity in limits
          && (periodicity != 'outra' || component.descricao.size() > 0)
          && validActivePaymentComponent(component, requireDates, limits[periodicity])
        : validInactivePaymentComponent(component, empty);
    }

    // Cada histórico inicial verifica metade dos grupos. A criação da proposta
    // exige os dois históricos novos na mesma transação, sem escritas extras.
    function validInitialHistory(data, historyId, unitHistory) {
      let proposal = getAfter(/databases/$(database)/documents/propostas/$(historyId)).data;
      let condition = proposal.condicaoProposta;
      let slots = condition.componentes.parcelas;
      let requireDates = condition.tipo == 'personalizada';
      let empty = {'ativo': false, 'quantidade': 0, 'valorUnitarioCentavos': 0,
        'totalCentavos': 0, 'periodicidade': 'outra',
        'primeiroVencimento': null, 'vencimentos': [], 'descricao': ''};
      let limits = {'mensal': 240, 'semestral': 60, 'anual': 30, 'outra': 1};
      return data.propostaId == historyId
        && data.corretorId == proposal.corretorId
        && data.unidadeId == proposal.unidadeId
        && data.data == request.time
        && !exists(/databases/$(database)/documents/propostas/$(historyId))
        && (unitHistory
          ? validFlexiblePaymentComponent(slots.grupo01, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo02, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo03, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo04, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo05, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo06, requireDates, empty, limits)
          : validFlexiblePaymentComponent(slots.grupo07, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo08, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo09, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo10, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo11, requireDates, empty, limits)
            && validFlexiblePaymentComponent(slots.grupo12, requireDates, empty, limits));
    }

    function hasInitialHistories(proposalId) {
      let unitHistory = getAfter(/databases/$(database)/documents/historico_unidades/$(proposalId)).data;
      let proposalHistory = getAfter(/databases/$(database)/documents/historico_propostas/$(proposalId)).data;
      return !exists(/databases/$(database)/documents/historico_unidades/$(proposalId))
        && !exists(/databases/$(database)/documents/historico_propostas/$(proposalId))
        && unitHistory.propostaId == proposalId && unitHistory.acao == 'unidade reservada'
        && proposalHistory.propostaId == proposalId && proposalHistory.acao == 'proposta criada';
    }

    function validConditionShape(condition) {
      return condition is map && (
        (
          condition.tipo == 'personalizada'
          && condition.schemaVersao == 3
          && condition.size() == 7
        )
        ||
        (
          condition.tipo == 'padrao'
          && condition.schemaVersao == 4
          && condition.size() == 13
          && condition.tipologia is string
          && condition.condicaoComercialSnapshot is map
          && condition.resumoPublicado is map
          && condition.diaVencimentoPadrao in [15, 30]
          && condition.dataBasePadrao is string
          && condition.calendarioPadrao is map
        )
      );
    }

    function validPaymentCondition(data, unidadeId, commercialUnitId) {
      let condition = data.condicaoProposta;
      let parts = condition.componentes;
      let slots = parts.parcelas;
      let operationalUnit = get(
        /databases/$(database)/documents/unidades/$(unidadeId)
      ).data;
      let commercialUnit = getAfter(
        /databases/$(database)/documents/site_units_test/$(commercialUnitId)
      ).data;
      let livePriceCents = commercialUnit.precoVista * 100;
      let tableValue = condition.valorTabelaCentavos;
      let total = condition.totalCalculadoCentavos;
      let requireDates = condition.tipo == 'personalizada';
      let empty = {'ativo': false, 'quantidade': 0, 'valorUnitarioCentavos': 0,
        'totalCentavos': 0, 'periodicidade': 'outra',
        'primeiroVencimento': null, 'vencimentos': [], 'descricao': ''};

      return condition is map
        && validConditionShape(condition)
        && condition.descricao is string
        && condition.descricao.size() > 0
        && condition.descricao.size() <= 1000
        && tableValue is int
        && total is int
        && condition.diferencaCentavos is int
        && commercialUnit.precoVista is number
        && commercialUnit.precoVista > 0
        && operationalUnit.status == 'disponivel'
        && operationalUnit.unidade is string
        && commercialUnit.unidade is string
        && commercialUnit.unidade == operationalUnit.unidade
        && tableValue >= livePriceCents - 0.5
        && tableValue <= livePriceCents + 0.5
        && total > 0
        && (
          (
            condition.tipo == 'padrao'
            && total == tableValue
            && condition.diferencaCentavos == 0
          )
          ||
          (
            condition.tipo == 'personalizada'
            && total * 100 >= tableValue * 85
            && condition.diferencaCentavos == tableValue - total
          )
        )
        && parts is map
        && parts.size() == 3
        && validSignalPaymentComponent(parts.sinal, requireDates, empty)
        && validOptionalFixedPaymentComponent(parts.chaves, 'unica', false, 1, empty)
        && slots is map && slots.size() == 12
        && parts.chaves.totalCentavos * 100 <= total * 60
        && total ==
          parts.sinal.totalCentavos
          + slots.grupo01.totalCentavos
          + slots.grupo02.totalCentavos
          + slots.grupo03.totalCentavos
          + slots.grupo04.totalCentavos
          + slots.grupo05.totalCentavos
          + slots.grupo06.totalCentavos
          + slots.grupo07.totalCentavos
          + slots.grupo08.totalCentavos
          + slots.grupo09.totalCentavos
          + slots.grupo10.totalCentavos
          + slots.grupo11.totalCentavos
          + slots.grupo12.totalCentavos
          + parts.chaves.totalCentavos;
    }

    match /condicoes_comerciais/{documentId} {
      allow read: if true;
      allow write: if false;
    }
    match /configuracoes_comerciais/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /corretores/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == false
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'cpf', 'creci', 'telefone', 'imobiliaria'])
      );

      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /unidades/{unidadeId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        isApprovedBroker()
        && resource.data.status == 'disponivel'
        && request.resource.data.status == 'reservada'
        && request.resource.data.propostaAtualId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'propostaAtualId', 'atualizadoEm', 'expiraEm', 'vendidoEm'])
        && getAfter(/databases/$(database)/documents/propostas/$(request.resource.data.propostaAtualId)).data.corretorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/propostas/$(request.resource.data.propostaAtualId)).data.unidadeId == unidadeId
      );
    }

    match /propostas/{propostaId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );

      allow create: if (
          (
            isApprovedBroker()
            && request.resource.data.corretorId == request.auth.uid
          )
          ||
          (
            isAdmin()
            && request.resource.data.corretorId is string
            && exists(/databases/$(database)/documents/corretores/$(request.resource.data.corretorId))
            && get(/databases/$(database)/documents/corretores/$(request.resource.data.corretorId)).data.aprovado == true
            && request.resource.data.adminId == request.auth.uid
          )
        )
        && request.resource.data.statusProposta == 'reservada'
        && request.resource.data.declaracaoAceita == true
        && request.resource.data.unidadeId is string
        
        && request.resource.data.commercialUnitId is string
        && validPaymentCondition(request.resource.data, request.resource.data.unidadeId, request.resource.data.commercialUnitId)
        && hasInitialHistories(propostaId)
        && getAfter(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.status == 'reservada'
        && getAfter(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.propostaAtualId == propostaId;

      allow update, delete: if isAdmin();

      match /documentos/{documentoId} {
        allow read: if canAccessProposal(propostaId);
        allow create: if isAdmin() || (
          isApprovedBroker()
          && ownsProposal(propostaId)
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.status == 'enviado'
        );
        allow update: if isAdmin() || (
          isApprovedBroker()
          && ownsProposal(propostaId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['arquivo', 'status', 'enviadoEm', 'atualizadoEm'])
          && request.resource.data.status == 'enviado'
        );
        allow delete: if false;
      }

      match /contratos/{contratoId} {
        allow read: if canAccessProposal(propostaId);
        allow create, update: if isAdmin();
        allow delete: if false;
      }

      match /mensagens/{mensagemId} {
        allow read: if canAccessProposal(propostaId);
        allow create: if canAccessProposal(propostaId)
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && (
            (isAdmin() && request.resource.data.autorTipo == 'admin')
            || (ownsProposal(propostaId) && request.resource.data.autorTipo == 'corretor')
          );
        allow update, delete: if false;
      }
    }

    match /historico_propostas/{historicoId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );
      allow create: if (isAdmin() || (
        isApprovedBroker()
        && request.resource.data.corretorId == request.auth.uid
        && request.resource.data.acao == 'proposta criada'
      )) && (request.resource.data.acao != 'proposta criada'
        || validInitialHistory(request.resource.data, historicoId, false));
      allow update, delete: if false;
    }

    match /historico_unidades/{historicoId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );
      allow create: if (isAdmin() || (
        isApprovedBroker()
        && request.resource.data.corretorId == request.auth.uid
        && request.resource.data.acao == 'unidade reservada'
      )) && (request.resource.data.acao != 'unidade reservada'
        || validInitialHistory(request.resource.data, historicoId, true));
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /configuracoes/{documento} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

  }
}

