rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // BETA 9 · LEITURA COMERCIAL TESTE
    // Coleções temporárias usadas somente durante a integração.
    // Escrita pelo cliente continua proibida.
    match /site_units_test/{unitId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /site_conditions_test/{documentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.tipo == 'admin';
    }

    function isApprovedBroker() {
      return signedIn()
        && exists(/databases/$(database)/documents/corretores/$(request.auth.uid))
        && get(/databases/$(database)/documents/corretores/$(request.auth.uid)).data.aprovado == true;
    }

    function ownsProposal(propostaId) {
      return signedIn()
        && exists(/databases/$(database)/documents/propostas/$(propostaId))
        && get(/databases/$(database)/documents/propostas/$(propostaId)).data.corretorId == request.auth.uid;
    }

    function canAccessProposal(propostaId) {
      return isAdmin() || ownsProposal(propostaId);
    }

    function validPaymentComponent(component, periodicity, requireDates, maxQuantity) {
      return component is map
        && component.keys().hasAll([
          'ativo', 'quantidade', 'valorUnitarioCentavos', 'totalCentavos',
          'periodicidade', 'primeiroVencimento', 'vencimentos', 'descricao'
        ])
        && component.keys().hasOnly([
          'ativo', 'quantidade', 'valorUnitarioCentavos', 'totalCentavos',
          'periodicidade', 'primeiroVencimento', 'vencimentos', 'descricao'
        ])
        && component.ativo is bool
        && component.quantidade is int
        && component.valorUnitarioCentavos is int
        && component.totalCentavos is int
        && component.periodicidade == periodicity
        && component.vencimentos is list
        && component.descricao is string
        && component.descricao.size() <= 300
        && (
          (
            component.ativo == true
            && component.quantidade > 0
            && component.quantidade <= maxQuantity
            && component.valorUnitarioCentavos > 0
            && component.totalCentavos == component.quantidade * component.valorUnitarioCentavos
            && (
              (
                requireDates == true
                && component.primeiroVencimento is timestamp
                && component.vencimentos.size() == component.quantidade
              )
              ||
              (
                requireDates == false
                && (component.primeiroVencimento == null || component.primeiroVencimento is timestamp)
              )
            )
          )
          ||
          (
            component.ativo == false
            && component.quantidade == 0
            && component.valorUnitarioCentavos == 0
            && component.totalCentavos == 0
            && component.primeiroVencimento == null
            && component.vencimentos.size() == 0
            && component.descricao == ''
          )
        );
    }

    function validOptionalFixedPaymentComponent(component, periodicity, requireDates, maxQuantity) {
      return component is map && (
        (
          component.ativo == false
          && validPaymentComponent(component, 'outra', requireDates, 1)
        )
        ||
        (
          component.ativo == true
          && validPaymentComponent(component, periodicity, requireDates, maxQuantity)
        )
      );
    }

    function validSignalPaymentComponent(component, requireDates) {
      return component is map && (
        (
          component.ativo == false
          && validPaymentComponent(component, 'outra', requireDates, 1)
        )
        ||
        (
          component.ativo == true
          && (
            validPaymentComponent(component, 'mensal', requireDates, 3)
            ||
            (
              component.quantidade == 1
              && validPaymentComponent(component, 'unica', requireDates, 1)
            )
          )
        )
      );
    }

    function validFlexiblePaymentComponent(component, requireDates) {
      return component is map && (
        (
          component.ativo == false
          && validPaymentComponent(component, 'outra', requireDates, 1)
        ) || (
          component.ativo == true
          && (
            validPaymentComponent(component, 'mensal', requireDates, 240)
            || validPaymentComponent(component, 'semestral', requireDates, 60)
            || validPaymentComponent(component, 'anual', requireDates, 30)
            || (
              validPaymentComponent(component, 'outra', requireDates, 1)
              && component.descricao.size() > 0
            )
          )
        )
      );
    }

    function validPaymentSlots(slots, requireDates) {
      return slots is map
        && slots.keys().hasAll([
          'grupo01', 'grupo02', 'grupo03', 'grupo04', 'grupo05', 'grupo06',
          'grupo07', 'grupo08', 'grupo09', 'grupo10', 'grupo11', 'grupo12'
        ])
        && slots.keys().hasOnly([
          'grupo01', 'grupo02', 'grupo03', 'grupo04', 'grupo05', 'grupo06',
          'grupo07', 'grupo08', 'grupo09', 'grupo10', 'grupo11', 'grupo12'
        ])
        && validFlexiblePaymentComponent(slots.grupo01, requireDates)
        && validFlexiblePaymentComponent(slots.grupo02, requireDates)
        && validFlexiblePaymentComponent(slots.grupo03, requireDates)
        && validFlexiblePaymentComponent(slots.grupo04, requireDates)
        && validFlexiblePaymentComponent(slots.grupo05, requireDates)
        && validFlexiblePaymentComponent(slots.grupo06, requireDates)
        && validFlexiblePaymentComponent(slots.grupo07, requireDates)
        && validFlexiblePaymentComponent(slots.grupo08, requireDates)
        && validFlexiblePaymentComponent(slots.grupo09, requireDates)
        && validFlexiblePaymentComponent(slots.grupo10, requireDates)
        && validFlexiblePaymentComponent(slots.grupo11, requireDates)
        && validFlexiblePaymentComponent(slots.grupo12, requireDates);
    }

    function validConditionShape(condition) {
      return condition is map && (
        (
          condition.tipo == 'personalizada'
          && condition.schemaVersao == 3
          && condition.keys().hasAll([
            'schemaVersao', 'tipo', 'descricao', 'valorTabelaCentavos',
            'totalCalculadoCentavos', 'diferencaCentavos', 'componentes'
          ])
          && condition.keys().hasOnly([
            'schemaVersao', 'tipo', 'descricao', 'valorTabelaCentavos',
            'totalCalculadoCentavos', 'diferencaCentavos', 'componentes'
          ])
        )
        ||
        (
          condition.tipo == 'padrao'
          && condition.schemaVersao == 4
          && condition.keys().hasAll([
            'schemaVersao', 'tipo', 'descricao', 'tipologia',
            'valorTabelaCentavos', 'totalCalculadoCentavos', 'diferencaCentavos',
            'condicaoComercialSnapshot', 'resumoPublicado', 'componentes',
            'diaVencimentoPadrao', 'dataBasePadrao', 'calendarioPadrao'
          ])
          && condition.keys().hasOnly([
            'schemaVersao', 'tipo', 'descricao', 'tipologia',
            'valorTabelaCentavos', 'totalCalculadoCentavos', 'diferencaCentavos',
            'condicaoComercialSnapshot', 'resumoPublicado', 'componentes',
            'diaVencimentoPadrao', 'dataBasePadrao', 'calendarioPadrao'
          ])
          && condition.tipologia is string
          && condition.condicaoComercialSnapshot is map
          && condition.resumoPublicado is map
          && condition.diaVencimentoPadrao in [15, 30]
          && condition.dataBasePadrao is string
          && condition.calendarioPadrao is map
        )
      );
    }

    function validPaymentCondition(data, unidadeId, commercialUnitId) {
      let condition = data.condicaoProposta;
      let parts = condition.componentes;
      let slots = parts.parcelas;
      let operationalUnit = getAfter(
        /databases/$(database)/documents/unidades/$(unidadeId)
      ).data;
      let commercialUnit = getAfter(
        /databases/$(database)/documents/site_units_test/$(commercialUnitId)
      ).data;
      let livePrice = commercialUnit.precoVista;
      let livePriceCents = livePrice * 100;
      let tableValue = condition.valorTabelaCentavos;
      let requireDates = condition.tipo == 'personalizada';

      return condition is map
        && validConditionShape(condition)
        && condition.descricao is string
        && condition.descricao.size() > 0
        && condition.descricao.size() <= 1000
        && condition.valorTabelaCentavos is int
        && condition.totalCalculadoCentavos is int
        && condition.diferencaCentavos is int
        && commercialUnit.precoVista is number
        && commercialUnit.precoVista > 0
        && operationalUnit.unidade is string
        && commercialUnit.unidade is string
        && commercialUnit.unidade == operationalUnit.unidade
        && condition.valorTabelaCentavos >= livePriceCents - 0.5
        && condition.valorTabelaCentavos <= livePriceCents + 0.5
        && condition.totalCalculadoCentavos > 0
        && (
          (
            condition.tipo == 'padrao'
            && condition.totalCalculadoCentavos == tableValue
            && condition.diferencaCentavos == 0
          )
          ||
          (
            condition.tipo == 'personalizada'
            && condition.totalCalculadoCentavos * 100 >= tableValue * 85
            && condition.diferencaCentavos == tableValue - condition.totalCalculadoCentavos
          )
        )
        && parts is map
        && parts.keys().hasAll(['sinal', 'parcelas', 'chaves'])
        && parts.keys().hasOnly(['sinal', 'parcelas', 'chaves'])
        && validSignalPaymentComponent(parts.sinal, requireDates)
        && validOptionalFixedPaymentComponent(parts.chaves, 'unica', false, 1)
        && validPaymentSlots(slots, requireDates)
        && parts.chaves.totalCentavos * 100 <= condition.totalCalculadoCentavos * 60
        && condition.totalCalculadoCentavos ==
          parts.sinal.totalCentavos
          + slots.grupo01.totalCentavos
          + slots.grupo02.totalCentavos
          + slots.grupo03.totalCentavos
          + slots.grupo04.totalCentavos
          + slots.grupo05.totalCentavos
          + slots.grupo06.totalCentavos
          + slots.grupo07.totalCentavos
          + slots.grupo08.totalCentavos
          + slots.grupo09.totalCentavos
          + slots.grupo10.totalCentavos
          + slots.grupo11.totalCentavos
          + slots.grupo12.totalCentavos
          + parts.chaves.totalCentavos;
    }

    match /condicoes_comerciais/{documentId} {
      allow read: if true;
      allow write: if false;
    }
    match /configuracoes_comerciais/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /corretores/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == false
        && request.resource.data.email == request.auth.token.email;

      allow update: if isAdmin() || (
        signedIn()
        && request.auth.uid == uid
        && request.resource.data.aprovado == resource.data.aprovado
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nome', 'cpf', 'creci', 'telefone', 'imobiliaria'])
      );

      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /unidades/{unidadeId} {
      allow read: if true;
      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        isApprovedBroker()
        && resource.data.status == 'disponivel'
        && request.resource.data.status == 'reservada'
        && request.resource.data.propostaAtualId is string
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'propostaAtualId', 'atualizadoEm', 'expiraEm', 'vendidoEm'])
        && getAfter(/databases/$(database)/documents/propostas/$(request.resource.data.propostaAtualId)).data.corretorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/propostas/$(request.resource.data.propostaAtualId)).data.unidadeId == unidadeId
      );
    }

    match /propostas/{propostaId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );

      allow create: if (
          (
            isApprovedBroker()
            && request.resource.data.corretorId == request.auth.uid
          )
          ||
          (
            isAdmin()
            && request.resource.data.corretorId is string
            && exists(/databases/$(database)/documents/corretores/$(request.resource.data.corretorId))
            && get(/databases/$(database)/documents/corretores/$(request.resource.data.corretorId)).data.aprovado == true
            && request.resource.data.adminId == request.auth.uid
          )
        )
        && request.resource.data.statusProposta == 'reservada'
        && request.resource.data.declaracaoAceita == true
        && request.resource.data.unidadeId is string
        
        && request.resource.data.commercialUnitId is string
        && validPaymentCondition(request.resource.data, request.resource.data.unidadeId, request.resource.data.commercialUnitId)
        && getAfter(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.status == 'reservada'
        && getAfter(/databases/$(database)/documents/unidades/$(request.resource.data.unidadeId)).data.propostaAtualId == propostaId;

      allow update, delete: if isAdmin();

      match /documentos/{documentoId} {
        allow read: if canAccessProposal(propostaId);
        allow create: if isAdmin() || (
          isApprovedBroker()
          && ownsProposal(propostaId)
          && request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.status == 'enviado'
        );
        allow update: if isAdmin() || (
          isApprovedBroker()
          && ownsProposal(propostaId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['arquivo', 'status', 'enviadoEm', 'atualizadoEm'])
          && request.resource.data.status == 'enviado'
        );
        allow delete: if false;
      }

      match /contratos/{contratoId} {
        allow read: if canAccessProposal(propostaId);
        allow create, update: if isAdmin();
        allow delete: if false;
      }

      match /mensagens/{mensagemId} {
        allow read: if canAccessProposal(propostaId);
        allow create: if canAccessProposal(propostaId)
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && (
            (isAdmin() && request.resource.data.autorTipo == 'admin')
            || (ownsProposal(propostaId) && request.resource.data.autorTipo == 'corretor')
          );
        allow update, delete: if false;
      }
    }

    match /historico_propostas/{historicoId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );
      allow create: if isAdmin() || (
        isApprovedBroker()
        && request.resource.data.corretorId == request.auth.uid
        && request.resource.data.acao == 'proposta criada'
      );
      allow update, delete: if false;
    }

    match /historico_unidades/{historicoId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.corretorId == request.auth.uid
      );
      allow create: if isAdmin() || (
        isApprovedBroker()
        && request.resource.data.corretorId == request.auth.uid
        && request.resource.data.acao == 'unidade reservada'
      );
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /configuracoes/{documento} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

  }
}

